rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Kullanıcı Profilleri: Sadece belgenin sahibi okuyabilir ve yazabilir
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == userId;
      allow update: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Genel Kütüphane Kartları: Herkes okuyabilir, sadece admin/console yazabilir
    match /prompts/{promptId} {
      allow read: if true;
      allow write: if false;
    }

    // 3. Kategoriler: Herkes okuyabilir, sadece admin/console yazabilir
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Varsayılan Kural: Tanımlanmamış tüm yollara erişimi tamamen engelle
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
